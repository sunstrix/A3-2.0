# Banco de Dados SQLite e H2 (Seguranca e Isolamento)
# -------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.mv.db
*.trace.db
*.h2.db
*.lck
data/

# -------------------------------------------------
