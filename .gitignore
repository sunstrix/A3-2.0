# Node / Frontend (caso build local com npm)
# -------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# -------------------------------------------------
# Relatorios, Dumps e Exportacoes Gerados
# -------------------------------------------------
*.csv
*.xlsx
*.pdf
*.sql
*.dump

# -------------------------------------------------
# Backup de versoes do Maven
# -------------------------------------------------
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties