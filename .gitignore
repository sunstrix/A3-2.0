# -------------------------------------------------
*.env
.env.*
application-local.properties
application-secrets.properties
*.key
*.pem
*.jks
*.p12

# -------------------------------------------------
# Arquivos de Upload e Temporarios
# -------------------------------------------------
uploads/
temp/
tmp/
*.tmp
*.tmp.*
*.bak
*.backup
*.orig
*.patch
*.diff
*.rej
*.swp
*.swo
*~

# -------------------------------------------------
# Arquivos de Sistema Operacional
# -------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# -------------------------------------------------
# Spring Boot e Temporarios
# -------------------------------------------------
HELP.md
.apt_generated
.springBeans
.sts4-cache
.apt_generated_tests/

